<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="TextDiffTool" value="C:\Program Files\Notepad++\notepad++.exe" />
    <add key="TextDiffToolArgs" value="-multiInst -nosession -pluginMessage=comparePlus" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
</configuration>
